{
  "name": "lumen-productivity",
  "version": "1.0.0",
  "description": "Lumen \u2014 Local-first personal command center & productivity operating system for tasks, goals, habits, notes, and focus.",
  "main": "app.js",
  "scripts": {
    "start": "serve . -l 8092 --no-clipboard",
    "dev": "vite --port 8092 --open",
    "build": "vite build && node scripts/postbuild.cjs && npm run check:budget",
    "check:budget": "node scripts/check-chunk-budget.cjs",
    "preview": "vite preview --port 8092",
    "test": "playwright test --reporter=list",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run test:unit && npm test",
    "lint": "eslint .",
    "precommit": "echo \"done\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miketeacher-ai/to-do-list-1.git"
  },
  "keywords": [
    "productivity",
    "kanban",
    "okr",
    "habits",
    "pomodoro",
    "pwa",
    "local-first",
    "zero-build",
    "web-crypto",
    "gemini-ai",
    "timeboxing"
  ],
  "author": "Lumen Contributors",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/miketeacher-ai/to-do-list-1/issues"
  },
  "homepage": "https://github.com/miketeacher-ai/to-do-list-1#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "serve": "^14.2.6",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}